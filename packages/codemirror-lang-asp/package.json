{
  "name": "codemirror-lang-asp",
  "version": "0.1.1",
  "keywords": [
    "codemirror",
    "lezer",
    "asp",
    "clingo",
    "answer-set-programming"
  ],
  "description": "clingo ASP language support for CodeMirror",
  "scripts": {
    "test": "mocha test/*.js",
    "build": "rollup -c && tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "prepare": "pnpm run build"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/legacy-modes": "^6.0.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.0.0",
    "@lezer/generator": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^26.0.0",
    "mocha": "^11.7.1",
    "rollup": "^4.45.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcschuster/lang-asp.git",
    "directory": "packages/codemirror-lang-asp"
  },
  "license": "MIT",
  "clingo": {
    "version": "5.8.2",
    "tree-sitter-clingo": "v1.0.6"
  }
}
